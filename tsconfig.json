{
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"]
		},
		"strict": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"lib": [
			"DOM",
			"ES2018",
			"ES2020.Promise"
		]
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"tests/**/*.ts"
	]
}
