{
	"name": "obsidian-papersync",
	"version": "0.1.3",
	"description": "Syncs handwritten scans from Google Drive, iCloud Drive, or any synced folder into your Obsidian vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"tsc": "tsc -noEmit -skipLibCheck && tsc -p tsconfig.e2e.json",
		"test": "jest --config jest.config.cjs --ci",
		"test:coverage": "jest --config jest.config.cjs --ci --coverage --coverageReporters=lcov --coverageReporters=text-summary",
		"test:dev": "jest --config jest.config.cjs --watch",
		"test:e2e": "npm run build && npx wdio run ./wdio.conf.mts",
		"version": "node version-bump.mjs && git add manifest.json versions.json README.md",
		"release": "bash scripts/release.sh",
		"lint": "eslint .",
		"format": "prettier --write src/ tests/"
	},
	"keywords": [
		"obsidian",
		"papersync",
		"handwriting",
		"sync",
		"google-drive",
		"icloud"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Papersync/obsidian-papersync.git"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.19.2",
		"@wdio/cli": "9.32.0",
		"@wdio/local-runner": "9.32.0",
		"@wdio/mocha-framework": "9.32.0",
		"@wdio/spec-reporter": "9.32.0",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "17.13.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"jiti": "2.7.0",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.15",
		"tslib": "2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.71.2",
		"wdio-obsidian-reporter": "^3.3.0",
		"wdio-obsidian-service": "^3.3.0"
	},
	"dependencies": {
		"obsidian": "1.14.4",
		"zod": "4.6.7"
	}
}
