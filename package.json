{
	"name": "obsidian-papersync",
	"version": "0.1.0",
	"description": "Syncs handwritten scans from Google Drive, iCloud Drive, or any synced folder into your Obsidian vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"tsc": "tsc -noEmit -skipLibCheck && tsc -p tsconfig.e2e.json",
		"test": "jest --config jest.config.cjs --ci",
		"test:dev": "jest --config jest.config.cjs --watch",
		"test:e2e": "npm run build && npx wdio run ./wdio.conf.mts",
		"version": "node version-bump.mjs && git add manifest.json versions.json README.md",
		"lint": "eslint .",
		"format": "prettier --write src/ tests/"
	},
	"keywords": [
		"obsidian",
		"papersync",
		"handwriting",
		"sync",
		"google-drive",
		"icloud"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Papersync/obsidian-papersync.git"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.19.0",
		"@wdio/cli": "9.32.0",
		"@wdio/local-runner": "9.32.0",
		"@wdio/mocha-framework": "9.32.0",
		"@wdio/spec-reporter": "9.32.0",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "17.7.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"jiti": "2.7.0",
		"prettier": "^3.9.9",
		"ts-jest": "^29.4.11",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.62.1",
		"wdio-obsidian-reporter": "^3.2.1",
		"wdio-obsidian-service": "^3.2.1"
	},
	"dependencies": {
		"obsidian": "1.13.1",
		"zod": "4.4.3"
	},
	"overrides": {
		"brace-expansion@^1": "^1.1.21"
	}
}
