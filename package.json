{
	"name": "obsidian-papersynced",
	"version": "1.0.0",
	"description": "Syncs handwritten scans from Google Drive or any folder (iCloud, Dropbox, OneDrive, Syncthing, Obsidian Sync) into your Obsidian vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "jest --config jest.config.cjs --ci",
		"test:dev": "jest --config jest.config.cjs --watch",
		"test:e2e": "npm run build && npx wdio run ./wdio.conf.mts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --write src/ tests/"
	},
	"keywords": [
		"obsidian",
		"papersynced",
		"handwriting",
		"sync",
		"google-drive",
		"icloud"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^16.11.6",
		"@wdio/cli": "^9.27.0",
		"@wdio/local-runner": "^9.27.0",
		"@wdio/mocha-framework": "^9.27.0",
		"@wdio/spec-reporter": "^9.27.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jest": "^30.3.0",
		"jest-environment-jsdom": "^30.3.0",
		"jiti": "2.6.1",
		"prettier": "^3.8.2",
		"ts-jest": "^29.4.9",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"wdio-obsidian-reporter": "^3.0.2",
		"wdio-obsidian-service": "^3.0.2"
	},
	"dependencies": {
		"obsidian": "latest",
		"zod": "^4.3.6"
	}
}
